{
	"name": "@dentalrx/n8n-nodes-appwrite",
	"version": "0.1.1",
	"description": "n8n community node for the Appwrite API: TablesDB, DocumentsDB and VectorsDB databases, dedicated databases, storage, functions, sites, users, teams and accounts, messaging, and project administration",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"appwrite",
		"tablesdb",
		"vectorsdb",
		"documentsdb",
		"backend",
		"baas",
		"database",
		"storage",
		"authentication"
	],
	"license": "MIT",
	"homepage": "https://github.com/DentalRx/n8n-nodes-appwrite",
	"bugs": {
		"url": "https://github.com/DentalRx/n8n-nodes-appwrite/issues"
	},
	"author": {
		"name": "DentalRx",
		"email": "admin@dentalrx.ca"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DentalRx/n8n-nodes-appwrite.git"
	},
	"engines": {
		"node": ">=20.15"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"prepublishOnly": "n8n-node prerelease",
		"release": "n8n-node release",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.test.json"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AppwriteApi.credentials.js",
			"dist/credentials/AppwriteOrganizationApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Appwrite/Appwrite.node.js"
		]
	},
	"auto-changelog": {
		"hideCredit": true
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.49.1",
		"@types/node": "^22.15.0",
		"eslint": "^9.39.5",
		"n8n-workflow": "2.41.0",
		"prettier": "^3.9.8",
		"release-it": "^21.1.0",
		"typescript": "^5.9.3",
		"vitest": "^5.0.1"
	}
}
